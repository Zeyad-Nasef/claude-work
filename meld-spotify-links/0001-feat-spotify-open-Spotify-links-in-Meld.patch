+    // ── Track (public track page, REST fallback) ────────────────────────
+    // REST tracks/{id} gets rate limited like top tracks, and getTrack isn't in the
+    // GQL hash registry, so read the link preview tags from the track page first.
+    // Spotify only serves those tags to non-browser clients, hence the plain UA.
+
+    private val pageClient by lazy {
+        HttpClient(OkHttp) {
+            defaultRequest {
+                header("User-Agent", "Meld")
+            }
+            expectSuccess = false
+        }
+    }
+
+    suspend fun track(trackId: String): Result<SpotifyTrack> =
+        runCatching {
+            val response = pageClient.get("https://open.spotify.com/track/$trackId")
+            val fromPage =
+                if (response.status.value in 200..299) {
+                    SpotifyTrackPage.parse(trackId, response.bodyAsText())
+                } else {
+                    null
+                }
+            fromPage ?: run {
+                log("W", "Track page for $trackId had no metadata (${response.status.value}), trying REST")
+                authenticatedGet<SpotifyTrack>("tracks/$trackId", failFastOn429 = true)
+            }
+        }
+
