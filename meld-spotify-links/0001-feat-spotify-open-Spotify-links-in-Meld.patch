@@ -0,0 +1,80 @@
+package com.metrolist.spotify
+
+import com.metrolist.spotify.SpotifyLink.Type
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SpotifyLinkTest {
+
+    private val id = "4uLU6hMCjMI75M1A2tKUQC"
+
+    @Test
+    fun `parses each supported web url type`() {
+        assertEquals(SpotifyLink(Type.TRACK, id), SpotifyLink.parse("https://open.spotify.com/track/$id"))
+        assertEquals(SpotifyLink(Type.ALBUM, id), SpotifyLink.parse("https://open.spotify.com/album/$id"))
+        assertEquals(SpotifyLink(Type.PLAYLIST, id), SpotifyLink.parse("https://open.spotify.com/playlist/$id"))
+        assertEquals(SpotifyLink(Type.ARTIST, id), SpotifyLink.parse("https://open.spotify.com/artist/$id"))
+    }
+
+    @Test
+    fun `ignores share tracking query and fragment`() {
+        assertEquals(
+            SpotifyLink(Type.TRACK, id),
+            SpotifyLink.parse("https://open.spotify.com/track/$id?si=a1b2c3d4e5f64a7b&context=spotify%3Aplaylist%3Ax#t=10"),
+        )
+    }
+
+    @Test
+    fun `handles locale embed and legacy user prefixes`() {
+        assertEquals(SpotifyLink(Type.TRACK, id), SpotifyLink.parse("https://open.spotify.com/intl-de/track/$id"))
+        assertEquals(SpotifyLink(Type.ALBUM, id), SpotifyLink.parse("https://open.spotify.com/intl-pt-BR/album/$id"))
+        assertEquals(SpotifyLink(Type.PLAYLIST, id), SpotifyLink.parse("https://open.spotify.com/embed/playlist/$id"))
+        assertEquals(
+            SpotifyLink(Type.PLAYLIST, id),
+            SpotifyLink.parse("https://open.spotify.com/user/spotify/playlist/$id"),
+        )
+    }
+
+    @Test
+    fun `parses spotify uris`() {
+        assertEquals(SpotifyLink(Type.TRACK, id), SpotifyLink.parse("spotify:track:$id"))
+        assertEquals(SpotifyLink(Type.PLAYLIST, id), SpotifyLink.parse("spotify:user:someone:playlist:$id"))
+    }
+
+    @Test
+    fun `finds the link inside shared text`() {
+        assertEquals(
+            SpotifyLink(Type.TRACK, id),
+            SpotifyLink.parse("Song Title - Artist https://open.spotify.com/track/$id?si=xyz"),
+        )
+    }
+
+    @Test
+    fun `album link with highlighted track opens the album`() {
+        assertEquals(
+            SpotifyLink(Type.ALBUM, id),
+            SpotifyLink.parse("https://open.spotify.com/album/$id?highlight=spotify:track:0VjIjW4GlUZAMYd2vXMi3b"),
+        )
+    }
+
+    @Test
+    fun `rejects unsupported types, bad ids and other hosts`() {
+        assertNull(SpotifyLink.parse("https://open.spotify.com/episode/$id"))
+        assertNull(SpotifyLink.parse("https://open.spotify.com/show/$id"))
+        assertNull(SpotifyLink.parse("https://open.spotify.com/track/short"))
+        assertNull(SpotifyLink.parse("https://open.spotify.com/track/${id}EXTRA"))
+        assertNull(SpotifyLink.parse("https://evil.example/open.spotify.com/track/$id"))
+        assertNull(SpotifyLink.parse("https://music.youtube.com/watch?v=dQw4w9WgXcQ"))
+    }
+
+    @Test
+    fun `isSpotifyLink flags unsupported spotify links but not other text`() {
+        assertTrue(SpotifyLink.isSpotifyLink("https://open.spotify.com/episode/$id"))
+        assertTrue(SpotifyLink.isSpotifyLink("spotify:show:$id"))
+        assertFalse(SpotifyLink.isSpotifyLink("https://music.youtube.com/watch?v=dQw4w9WgXcQ"))
+        assertFalse(SpotifyLink.isSpotifyLink("Now playing on spotify: great song"))
+    }
+}
