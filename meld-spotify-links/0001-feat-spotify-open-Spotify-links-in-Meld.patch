+package com.metrolist.spotify
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+// Tags copied from real open.spotify.com track pages.
+class SpotifyTrackPageTest {
+
+    @Test
+    fun `reads a single artist track`() {
+        val html = """
+            <meta property="og:site_name" content="Spotify"/>
+            <meta property="og:title" content="Black Friday - Mahogany Session"/>
+            <meta property="og:description" content="Tom Odell · Black Friday EP · Song · 2024"/>
+            <meta property="og:image" content="https://i.scdn.co/image/ab67616d0000b273614a1828185a325ad7e35334"/>
+            <meta name="music:duration" content="224"/>
+            <meta name="music:album" content="https://open.spotify.com/album/0g5N9f6FpdYuON9ahdmu5n"/>
+            <meta name="music:musician" content="https://open.spotify.com/artist/2txHhyCwHjUEpJjWrEyqyX"/>
+            <meta name="music:musician_description" content="Tom Odell"/>
+        """.trimIndent()
+
+        val track = SpotifyTrackPage.parse("7ymcTupikH8sq5OtHWCLZK", html)!!
+
+        assertEquals("7ymcTupikH8sq5OtHWCLZK", track.id)
+        assertEquals("Black Friday - Mahogany Session", track.name)
+        assertEquals(224_000, track.durationMs)
+        assertEquals("spotify:track:7ymcTupikH8sq5OtHWCLZK", track.uri)
+        assertEquals(1, track.artists.size)
+        assertEquals("Tom Odell", track.artists[0].name)
+        assertEquals("2txHhyCwHjUEpJjWrEyqyX", track.artists[0].id)
+        assertEquals("0g5N9f6FpdYuON9ahdmu5n", track.album?.id)
+        assertEquals("Black Friday EP", track.album?.name)
+        assertEquals(
+            "https://i.scdn.co/image/ab67616d0000b273614a1828185a325ad7e35334",
+            track.album?.images?.firstOrNull()?.url,
+        )
+    }
+
+    @Test
+    fun `pairs multiple artists with their links`() {
+        val html = """
+            <meta property="og:title" content="Señorita"/>
+            <meta property="og:description" content="Shawn Mendes, Camila Cabello · Shawn Mendes (Deluxe) · Song · 2019"/>
+            <meta name="music:duration" content="191"/>
+            <meta name="music:album" content="https://open.spotify.com/album/0xzScN8P3hQAz3BT3YYX5w"/>
+            <meta name="music:musician" content="https://open.spotify.com/artist/7n2wHs1TKAczGzO7Dd2rGr"/>
+            <meta name="music:musician" content="https://open.spotify.com/artist/4nDoRrQiYLoBzwC5BhVJzF"/>
+            <meta name="music:musician_description" content="Shawn Mendes, Camila Cabello"/>
+        """.trimIndent()
+
+        val track = SpotifyTrackPage.parse("6v3KW9xbzN5yKLt9YKDYA2", html)!!
+
+        assertEquals(listOf("Shawn Mendes", "Camila Cabello"), track.artists.map { it.name })
+        assertEquals(listOf("7n2wHs1TKAczGzO7Dd2rGr", "4nDoRrQiYLoBzwC5BhVJzF"), track.artists.map { it.id })
+        assertEquals("Shawn Mendes (Deluxe)", track.album?.name)
+    }
+
+    @Test
+    fun `decodes html entities`() {
