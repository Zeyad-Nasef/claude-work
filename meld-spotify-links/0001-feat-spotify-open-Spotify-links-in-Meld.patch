new file mode 100644
index 0000000..75865f8
--- /dev/null
+++ b/app/src/main/kotlin/com/metrolist/spotify/SpotifyLink.kt
@@ -0,0 +1,32 @@
+package com.metrolist.spotify
+
+data class SpotifyLink(
+    val type: Type,
+    val id: String,
+) {
+    enum class Type { TRACK, ALBUM, PLAYLIST, ARTIST }
+
+    companion object {
+        private const val TYPE = "(track|album|playlist|artist)"
+        private const val ID = "([A-Za-z0-9]{22})(?![A-Za-z0-9])"
+
+        // Spotify sometimes puts a locale (/intl-de/), /embed/ or a legacy /user/<name>/
+        // before the item type.
+        private val WEB_URL =
+            Regex(
+                "https?://open\\.spotify\\.com/(?:intl-[a-z-]+/)?(?:embed/)?(?:user/[^/?#\\s]+/)?$TYPE/$ID",
+                RegexOption.IGNORE_CASE,
+            )
+        private val URI = Regex("spotify:(?:user:[^:\\s]+:)?$TYPE:$ID", RegexOption.IGNORE_CASE)
+        private val ANY_SPOTIFY = Regex("https?://open\\.spotify\\.com/|spotify:[a-z]+:", RegexOption.IGNORE_CASE)
+
+        // Searches the whole string because shared text often has the title before the link.
+        fun parse(text: String): SpotifyLink? {
+            val match = WEB_URL.find(text) ?: URI.find(text) ?: return null
+            val (type, id) = match.destructured
+            return SpotifyLink(Type.valueOf(type.uppercase()), id)
+        }
+
+        fun isSpotifyLink(text: String): Boolean = ANY_SPOTIFY.containsMatchIn(text)
+    }
+}
diff --git a/app/src/main/kotlin/com/metrolist/spotify/SpotifyTrackPage.kt b/app/src/main/kotlin/com/metrolist/spotify/SpotifyTrackPage.kt
new file mode 100644
index 0000000..89ab23c
--- /dev/null
+++ b/app/src/main/kotlin/com/metrolist/spotify/SpotifyTrackPage.kt
@@ -0,0 +1,69 @@
+package com.metrolist.spotify
+
+import com.metrolist.spotify.models.SpotifyImage
+import com.metrolist.spotify.models.SpotifySimpleAlbum
+import com.metrolist.spotify.models.SpotifySimpleArtist
+import com.metrolist.spotify.models.SpotifyTrack
+
+/** Reads a track from the link preview tags of its open.spotify.com page. */
+internal object SpotifyTrackPage {
+    private val META_TAG = Regex("<meta (?:property|name)=\"([^\"]+)\" content=\"([^\"]*)\"")
+    private val HTML_ENTITY = Regex("&(#x[0-9a-fA-F]+|#[0-9]+|amp|quot|apos|lt|gt);")
+
+    fun parse(
+        trackId: String,
+        html: String,
+    ): SpotifyTrack? {
+        val tags = META_TAG.findAll(html).groupBy({ it.groupValues[1] }, { decode(it.groupValues[2]) })
+        fun tag(name: String) = tags[name]?.firstOrNull()?.takeIf { it.isNotBlank() }
+
+        val name = tag("og:title") ?: return null
+
+        // Names come joined with ", ", which breaks names like "Tyler, The Creator",
+        // so only split them when the count matches the artist links.
+        val artistIds = tags["music:musician"].orEmpty().map { it.idFromUrl() }
+        val artistNames = tag("music:musician_description").orEmpty()
+        val names = artistNames.split(", ").takeIf { it.size == artistIds.size } ?: listOf(artistNames)
+        val artists =
+            names.filter { it.isNotBlank() }.mapIndexed { i, artistName ->
+                val id = artistIds.getOrNull(i)
+                SpotifySimpleArtist(id = id, name = artistName, uri = id?.let { "spotify:artist:$it" })
+            }
+
+        val album =
+            tag("music:album")?.idFromUrl()?.let { albumId ->
+                SpotifySimpleAlbum(
+                    id = albumId,
+                    // og:description is "Artist · Album · Song · Year"
+                    name = tag("og:description")?.split(" · ")?.getOrNull(1).orEmpty(),
+                    images = listOfNotNull(tag("og:image")?.let { SpotifyImage(url = it) }),
+                    uri = "spotify:album:$albumId",
+                )
+            }
+
+        return SpotifyTrack(
+            id = trackId,
+            name = name,
+            artists = artists,
+            album = album,
+            durationMs = (tag("music:duration")?.toIntOrNull() ?: 0) * 1000,
+            uri = "spotify:track:$trackId",
+        )
+    }
+
+    private fun String.idFromUrl() = substringBefore('?').trimEnd('/').substringAfterLast('/')
+
+    private fun decode(text: String) =
+        HTML_ENTITY.replace(text) { match ->
+            val entity = match.groupValues[1]
+            when {
+                entity.startsWith("#x") -> entity.drop(2).toIntOrNull(16)?.let { String(Character.toChars(it)) }
+                entity.startsWith("#") -> entity.drop(1).toIntOrNull()?.let { String(Character.toChars(it)) }
+                entity == "amp" -> "&"
+                entity == "quot" -> "\""
+                entity == "apos" -> "'"
+                entity == "lt" -> "<"
+                else -> ">"
+            } ?: match.value
+        }
+}
