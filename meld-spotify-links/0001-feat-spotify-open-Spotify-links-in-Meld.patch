+    private fun openSpotifyLink(
+        link: SpotifyLink,
+        navController: NavHostController,
+    ) {
+        lifecycle.coroutineScope.launch {
+            if (!SpotifyTokenManager.ensureAuthenticated()) {
+                Toast.makeText(this@MainActivity, R.string.spotify_link_login_required, Toast.LENGTH_LONG).show()
+                navController.navigate("settings/spotify/login")
+                return@launch
+            }
+
+            when (link.type) {
+                SpotifyLink.Type.PLAYLIST -> navController.navigate("spotify_playlist/${link.id}")
+
+                SpotifyLink.Type.ALBUM -> navController.navigate("spotify_album/${link.id}")
+
+                SpotifyLink.Type.TRACK -> {
+                    val track =
+                        withContext(Dispatchers.IO) { Spotify.track(link.id) }
+                            .onFailure { reportException(it) }
+                            .getOrNull()
+                    if (track == null) {
+                        Toast.makeText(this@MainActivity, R.string.spotify_link_failed, Toast.LENGTH_SHORT).show()
+                        return@launch
+                    }
+                    playerConnection?.playQueue(
+                        SpotifyQueue(
+                            initialTrack = track,
+                            mapper = SpotifyYouTubeMapper(database),
+                            context = applicationContext,
+                            database = database,
+                        ),
+                    )
+                }
+
+                // No Spotify artist screen, same as the home feed we open the YT Music artist
+                SpotifyLink.Type.ARTIST -> {
+                    val youtubeArtistId =
+                        withContext(Dispatchers.IO) {
+                            val name = Spotify.artist(link.id).getOrNull()?.name
+                            if (name.isNullOrBlank()) return@withContext null
+                            YouTube
+                                .search(name, YouTube.SearchFilter.FILTER_ARTIST)
+                                .getOrNull()
+                                ?.items
+                                ?.firstOrNull { it is ArtistItem }
+                                ?.id
+                        }
+                    if (youtubeArtistId == null) {
+                        Toast.makeText(this@MainActivity, R.string.spotify_link_failed, Toast.LENGTH_SHORT).show()
+                        return@launch
+                    }
+                    navController.navigate("artist/$youtubeArtistId")
+                }
+            }
+        }
+    }
